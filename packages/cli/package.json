{
  "name": "maxsimcli",
  "version": "5.24.0",
  "private": false,
  "description": "A meta-prompting, context engineering and spec-driven development system for Claude Code by MayStudios.",
  "bin": {
    "maxsimcli": "dist/install.cjs"
  },
  "main": "./dist/cli.cjs",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/inject-version.cjs && npx tsdown && node scripts/copy-assets.cjs",
    "test": "npx vitest run",
    "test:e2e": "npx vitest run --config vitest.e2e.config.ts",
    "lint": "npx biome check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "meta-prompting",
    "context-engineering",
    "spec-driven-development"
  ],
  "author": "MayStudios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maystudios/maxsimcli.git"
  },
  "homepage": "https://maxsimcli.dev",
  "bugs": {
    "url": "https://github.com/maystudios/maxsimcli/issues"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.3.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
