{
  "version": "6.0.0",
  "execution": {
    "modelProfile": "balanced",
    "parallelism": {
      "maxAgentsPerWave": 3,
      "maxRetries": 3,
      "competitionStrategy": "none"
    },
    "verification": {
      "strictMode": true,
      "gates": ["tests", "build", "lint", "spec", "review"],
      "requireCodeReview": true,
      "autoResolveConflicts": true
    }
  },
  "worktrees": {
    "basePath": ".maxsim-worktrees/",
    "autoCleanup": true,
    "branchPrefix": "maxsim/"
  },
  "automation": {
    "autoCommitOnSuccess": true,
    "conventionalCommits": true
  },
  "github": {
    "projectName": "",
    "autoPush": true
  },
  "hooks": {
    "enabled": true
  }
}
